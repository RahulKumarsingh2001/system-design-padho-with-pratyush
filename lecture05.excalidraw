      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In starting if we have less no. of user then we can go with vertical scaling \nbecause it was easy to implements\n\nbut when we see more no. of user comes abd we faced ceiling, cost types of problem\nthen we can move towards the Horizontal Scaling",
      "autoResize": true,
      "lineHeight": 1.25
    },
