    {
      "id": "ktb1p5nwDTfWw3WPiMnAr",
      "type": "text",
      "x": 2466.8048964037425,
      "y": 1474.2804719200535,
      "width": 810.7994995117188,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 23526917,
      "version": 267,
      "versionNonce": 292162053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794057285224,
      "link": null,
      "locked": false,
      "text": "-> 50 crore daily active users\n-> 1 user send 40 message per day\n-> they send 2 types of message text or image {now we not consider video parts}\n-> 1 text msg = 200 bytes\n-> 1 photo = 200 kb\n-> 90% message = text message, 10% message = image",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> 50 crore daily active users\n-> 1 user send 40 message per day\n-> they send 2 types of message text or image {now we not consider video parts}\n-> 1 text msg = 200 bytes\n-> 1 photo = 200 kb\n-> 90% message = text message, 10% message = image",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Xks5kfP_ukPS1Rx0Jz7WU",
      "type": "text",
      "x": 2445.934460609266,
      "y": 1770.8479722309248,
      "width": 596.6397705078125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
      "roundness": null,
      "seed": 1262815051,
      "version": 202,
      "versionNonce": 66757931,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794057626367,
      "link": null,
      "locked": false,
      "text": "ThroughPut:- \n                    Total user = 50 crore => 50 x 10^7\n                    1 user send req/day = 40\n                    1 day req per sec = 40/86400\n                    No of req per sec = (40/86400) x 50 x 10^7",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ThroughPut:- \n                    Total user = 50 crore => 50 x 10^7\n                    1 user send req/day = 40\n                    1 day req per sec = 40/86400\n                    No of req per sec = (40/86400) x 50 x 10^7",
      "autoResize": true,
      "lineHeight": 1.25
    },
