      "updated": 1795542849291,
      "link": null,
      "locked": false,
      "text": "For sending a data they have 2 technique\n    1) synchronous\n    2) Asynchronous",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For sending a data they have 2 technique\n    1) synchronous\n    2) Asynchronous",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VZlbspXU8ym1Jy4yF3Au1",
      "type": "text",
      "x": 1871.507892254137,
      "y": 1885.9440670230172,
      "width": 598.65966796875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 522736509,
      "version": 307,
      "versionNonce": 20214323,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795543394103,
      "link": null,
      "locked": false,
      "text": "synchronous:- it was a safe way, but it take a time\n               -> if all machine can write then it was completed \n               -> by any chance one machine not able to write\n                  then was stoped/ glich not going to complete\n\nAsynchronous:- it was fast, but it stale data.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "synchronous:- it was a safe way, but it take a time\n               -> if all machine can write then it was completed \n               -> by any chance one machine not able to write\n                  then was stoped/ glich not going to complete\n\nAsynchronous:- it was fast, but it stale data.",
      "autoResize": true,
      "lineHeight": 1.25
    },
