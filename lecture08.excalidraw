      "type": "text",
      "x": 1506.6641808258735,
      "y": 1084.0055473036014,
      "width": 991.3795166015625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 1655265245,
      "version": 678,
      "versionNonce": 1654076157,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "RDfy4fanmGMLeF66Cb386",
          "type": "arrow"
        }
      ],
      "updated": 1795544310192,
      "link": null,
      "locked": false,
      "text": "1> Leader-follower:-  (i) In this algo. we make a one leader and rest of the machine are follower\n                          (ii) if we want to write/change any thing then we can do in leader machine\n                          (iii) then leader machine have all responsibility to update all the follower machine\n\ntake a simple example we have 4 machine. \n    your data are present in all 4 machine\nNow, we want to add some new data",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1> Leader-follower:-  (i) In this algo. we make a one leader and rest of the machine are follower\n                          (ii) if we want to write/change any thing then we can do in leader machine\n                          (iii) then leader machine have all responsibility to update all the follower machine\n\ntake a simple example we have 4 machine. \n    your data are present in all 4 machine\nNow, we want to add some new data",
      "autoResize": true,
      "lineHeight": 1.25
    },
