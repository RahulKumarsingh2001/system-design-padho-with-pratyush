      "isDeleted": false,
      "boundElements": null,
      "updated": 1793726281613,
      "link": null,
      "locked": false,
      "text": "In system design there are 2 types of design \n(1) High Level Design (HLD)\n(2) Low Level Design (LLD) {machine coding}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In system design there are 2 types of design \n(1) High Level Design (HLD)\n(2) Low Level Design (LLD) {machine coding}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
