      "index": "aV",
      "roundness": null,
      "seed": 1807951822,
      "version": 34,
      "versionNonce": 1217873422,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793726307548,
      "link": null,
      "locked": false,
