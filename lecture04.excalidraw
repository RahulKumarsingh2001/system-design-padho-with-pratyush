      "updated": 1794745187574,
      "link": null,
      "locked": false,
      "text": "when you upload a video in youtube then they have some steps\n\nstep 1: upload a video in youtube studio -> (it depend on size)\nstep 2: processing -> take a time based on your quality (4k, 5k etc.)\nstep 3: copywrite check",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "when you upload a video in youtube then they have some steps\n\nstep 1: upload a video in youtube studio -> (it depend on size)\nstep 2: processing -> take a time based on your quality (4k, 5k etc.)\nstep 3: copywrite check",
      "autoResize": true,
      "lineHeight": 1.25
    },
