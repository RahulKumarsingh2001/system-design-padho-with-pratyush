    {
      "id": "PKSbGXz01h_iqUze4_9KA",
      "type": "text",
      "x": 3159.9338970480035,
      "y": 228.67989311508478,
      "width": 467.65972900390625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
